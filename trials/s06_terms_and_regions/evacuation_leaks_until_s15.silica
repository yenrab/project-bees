// S6: evacuation. Each message, the actor copies its one live term into a fresh region and
// keeps that region as its state. Correct (prints 1000), but the replaced regions are never
// freed: 100,000 such messages peak at 551 MB RSS. That is the S-15 gap, measured.
fn some_term(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> ref?(L, normal, rec) { c }

fn beh(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, rec) }) -> (:reply, int64, { r: region(L, normal), root: ref?(L, normal, rec) }) {
    sequence proc[mem(normal)]
        old_v: int64 <- case state.root of {
            :none -> 0;
            c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> {
                node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: atom, v: int64, _: ref?(L, normal, rec)) <- node;
                v
            }
        };
        L: lifetime <- fresh_lifetime();
        fresh: region(L, normal) <- alloc_region(normal);
        moved: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(fresh, (:int, old_v + msg, :none))
    produces pure (:reply, old_v + msg, { r: fresh, root: some_term(moved) }) end
}

fn send_n(a: actor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        v: int64 <- call(a, 1 impl ActorMessage {});
        rest: int64 <- case n <= 1 of { true -> v; false -> send_n(a, n - 1) }
    produces pure rest end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        a: actor_ref <- spawn({ r: r, root: :none }, beh);
        last: int64 <- send_n(a, 1000);
        _: atom <- print_int64(last);
        println("")
    produces pure 0 end
}
