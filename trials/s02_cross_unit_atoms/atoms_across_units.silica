// Spike S2 under D30: atoms minted in unit A (through bees_atoms), classified in unit B, and
// compared here in a third unit, also through bees_atoms. No unit but bees_atoms writes an
// atom literal. Expected: 3 1 2 / true / mango / 2 7 / true true true / true false
use bees_atoms;
use bees_spike_atom_a;
use bees_spike_atom_b;

fn main() -> int64 {
    sequence proc[device_io]
        m: atom <- bees_spike_atom_a@mint_mango();
        z: atom <- bees_spike_atom_a@mint_zebra();
        a: atom <- bees_spike_atom_a@mint_apple();
        _: atom <- print_int64(bees_spike_atom_b@classify(z));
        print_string(" ");
        _: atom <- print_int64(bees_spike_atom_b@classify(a));
        print_string(" ");
        _: atom <- print_int64(bees_spike_atom_b@classify(m));
        println("");
        _: atom <- print_bool(bees_spike_atom_b@is_mango(m));
        println("");
        println(bees_spike_atom_b@spelling(m));
        p: (atom, int64) <- bees_spike_atom_a@mint_pair();
        (pa: atom, pn: int64) <- p;
        _: atom <- print_int64(bees_spike_atom_b@classify(pa));
        print_string(" ");
        _: atom <- print_int64(pn);
        println("");
        // Comparisons in this unit against values from bees_atoms.
        _: atom <- print_bool(m == bees_atoms@a_mango());
        print_string(" ");
        _: atom <- print_bool(z == bees_atoms@a_zebra());
        print_string(" ");
        _: atom <- print_bool(a != bees_atoms@a_zebra());
        println("");
        // The reverse lookup (list_to_existing_atom's core): a spelling the program holds, and one it doesn't.
        f1: { found: boolean, value: atom } <- bees_atoms@from_spelling("zebra");
        f2: { found: boolean, value: atom } <- bees_atoms@from_spelling("giraffe");
        _: atom <- print_bool(f1.found and f1.value == z);
        print_string(" ");
        _: atom <- print_bool(f2.found);
        println("")
    produces pure 0 end
}
