// S9 reference lowering 3: funs and apply/3.
//
//   -module(m).
//   twice(F, X) -> F(F(X)).
//   run() -> Add = fun(N) -> N + 3 end, twice(Add, 10).           % 16
//   dyn() -> apply(m, twice, [fun(N) -> N * 2 end, 5]).           % 20
//
// A fun is a term (tag 8): n = module index, h = cons(fn index, env list). Each module emits
// apply_fun(fun, args): a case over its fn indices calling the lifted closure bodies, and an
// apply entry: a case over its exported (name, arity) pairs. bees_config combines the modules'
// entries into the program-wide module table (here: one module, index 0).
// Expected: 16 20
use bees_term;

// lifted closure bodies: (heap, env, args) -> result
fn closure_0(h: { r: region(L, normal) }, env: ref?(L, normal, rec), args: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    bees_term@mk_int(h, bees_term@int_of(bees_term@nth(args, 0)) + 3)
}
fn closure_1(h: { r: region(L, normal) }, env: ref?(L, normal, rec), args: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    bees_term@mk_int(h, bees_term@int_of(bees_term@nth(args, 0)) * 2)
}

// the module's fun dispatch entry
fn apply_fun(h: { r: region(L, normal) }, f: ref?(L, normal, rec), args: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    case bees_term@int_of(bees_term@hd_of(bees_term@hd_of(f))) of {
        0 -> closure_0(h, bees_term@tl_of(bees_term@hd_of(f)), args);
        1 -> closure_1(h, bees_term@tl_of(bees_term@hd_of(f)), args);
        _: int64 -> bees_term@mk_nil(h)
    }
}

// a fun literal with an empty environment
fn fun_lit(h: { r: region(L, normal) }, idx: int64) -> ref?(L, normal, rec) {
    bees_term@mk_fun(h, 0, bees_term@mk_cons(h, bees_term@mk_int(h, idx), bees_term@mk_nil(h)))
}

// [X] as an argument list
fn args1(h: { r: region(L, normal) }, x: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    bees_term@mk_cons(h, x, bees_term@mk_nil(h))
}

// twice(F, X) -> F(F(X)).
fn twice(h: { r: region(L, normal) }, f: ref?(L, normal, rec), x: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    apply_fun(h, f, args1(h, apply_fun(h, f, args1(h, x))))
}

// apply(m, twice, [F, X]) through the module's apply entry: (function index, args)
fn apply_entry(h: { r: region(L, normal) }, fn_index: int64, args: ref?(L, normal, rec)) -> ref?(L, normal, rec) {
    case fn_index of {
        0 -> twice(h, bees_term@nth(args, 0), bees_term@nth(args, 1));
        _: int64 -> bees_term@mk_nil(h)
    }
}

fn main() -> int64 {
    sequence proc[mem(normal), device_io]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        h: { r: region(L, normal) } <- { r: r };
        _: atom <- print_int64(bees_term@int_of(twice(h, fun_lit(h, 0), bees_term@mk_int(h, 10))));
        print_string(" ");
        // dyn(): apply(m, twice, [fun(N) -> N * 2 end, 5]) through the apply entry
        args: { c: ref?(L, normal, rec) } <- { c: bees_term@mk_cons(h, fun_lit(h, 1), bees_term@mk_cons(h, bees_term@mk_int(h, 5), bees_term@mk_nil(h))) };
        _: atom <- print_int64(bees_term@int_of(apply_entry(h, 0, args.c)));
        println("")
    produces pure 0 end
}
