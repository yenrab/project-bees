// S3: 200,000 call round trips to one call-only actor: ~5 µs each (0.98 s wall, mostly sys).
fn echo(msg: int64, state: int64) -> (:reply, int64, int64) { (:reply, msg + state, state) }
fn call_n(a: actor_ref, n: int64, acc: int64) -> int64 {
    sequence proc[concurrency]
        v: int64 <- call(a, 1 impl ActorMessage {});
        rest: int64 <- case n <= 1 of { true -> acc + v; false -> call_n(a, n - 1, acc + v) }
    produces pure rest end
}
fn main() -> int64 {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(0, echo);
        n: int64 <- call_n(a, 200000, 0);
        _: atom <- print_int64(n);
        println("")
    produces pure 0 end
}
