fn p2s0() -> float64 { 2.0 }
fn p2s1() -> float64 { 4.0 }
fn p2s2() -> float64 { 16.0 }
fn p2s3() -> float64 { 256.0 }
fn p2s4() -> float64 { 65536.0 }
fn p2s5() -> float64 { 4294967296.0 }
fn p2s6() -> float64 { 1.8446744073709552e+19 }
fn p2s7() -> float64 { 3.402823669209385e+38 }
fn p2s8() -> float64 { 1.157920892373162e+77 }
fn p2s9() -> float64 { 1.3407807929942597e+154 }

fn one() -> float64 { 1.0 }
fn zero() -> float64 { 0.0 }
fn f256() -> float64 { 256.0 }
fn pow2_step(i: int64) -> float64 {
    case i of {
        0 -> p2s0();
        1 -> p2s1();
        2 -> p2s2();
        3 -> p2s3();
        4 -> p2s4();
        5 -> p2s5();
        6 -> p2s6();
        7 -> p2s7();
        8 -> p2s8();
        9 -> p2s9();
        _: int64 -> one()
    }
}

fn is_zero(k: int64) -> boolean { k == 0 }
fn is_odd(k: int64) -> boolean { k % 2 == 1 }

// 2^k for 0 <= k < 1024, by binary decomposition of k (exact).
fn pow2(k: int64, i: int64, acc: float64) -> float64 {
    case is_zero(k) of {
        true -> acc;
        false -> case is_odd(k) of {
            true -> pow2(k / 2, i + 1, acc * pow2_step(i));
            false -> pow2(k / 2, i + 1, acc)
        }
    }
}

// v * 2^e for -1074 <= e <= 1023, staying finite at every step.
fn scale2(v: float64, e: int64) -> float64 {
    case e >= 0 of {
        true -> case e > 1000 of {
            true -> scale2(v * pow2(1000, 0, one()), e - 1000);
            false -> v * pow2(e, 0, one())
        };
        false -> case e < 0 - 1000 of {
            true -> scale2(v / pow2(1000, 0, one()), e + 1000);
            false -> v / pow2(0 - e, 0, one())
        }
    }
}

fn byte_f(b: buf(L, normal, uint8, 8), i: int64) -> float64 {
    sequence proc[mem(normal)]
        v: uint8 <- read_buf(b, i)
    produces pure u8_to_f64(v) end
}
fn byte_i(b: buf(L, normal, uint8, 8), i: int64) -> int64 {
    sequence proc[mem(normal)]
        v: uint8 <- read_buf(b, i)
    produces pure u8_to_i64(v) end
}

fn exp_bits(b: buf(L, normal, uint8, 8)) -> int64 { (byte_i(b, 7) % 128) * 16 + byte_i(b, 6) / 16 }
fn sign_bit(b: buf(L, normal, uint8, 8)) -> boolean { byte_i(b, 7) >= 128 }
fn nibble_f(b: buf(L, normal, uint8, 8)) -> float64 { u8_to_f64(low_byte(byte_i(b, 6) % 16)) }

// the 52-bit mantissa as an integer-valued float
fn mant_f(b: buf(L, normal, uint8, 8)) -> float64 {
    (((((nibble_f(b) * f256() + byte_f(b, 5)) * f256() + byte_f(b, 4)) * f256() + byte_f(b, 3)) * f256() + byte_f(b, 2)) * f256() + byte_f(b, 1)) * f256() + byte_f(b, 0)
}

fn magnitude(b: buf(L, normal, uint8, 8)) -> float64 {
    case is_zero(exp_bits(b)) of {
        true -> scale2(mant_f(b), 0 - 1074);
        false -> scale2(pow2(52, 0, one()) + mant_f(b), exp_bits(b) - 1023 - 52)
    }
}

fn negate_if(neg: boolean, m: float64) -> float64 {
    case neg of { true -> zero() - m; false -> m }
}

fn decode_f64(b: buf(L, normal, uint8, 8)) -> float64 { negate_if(sign_bit(b), magnitude(b)) }

// ---- encoding ----
fn is_neg(v: float64) -> boolean { v < zero() }
fn is_zero_f(v: float64) -> boolean { v == zero() }
fn abs_f(v: float64) -> float64 { case is_neg(v) of { true -> zero() - v; false -> v } }

// Largest e with 2^e <= v, for finite v > 0, by descending search from 1023.
fn exponent_of(v: float64, e: int64) -> int64 {
    case e <= 0 - 1074 of {
        true -> 0 - 1074;
        false -> case scale2(one(), e) <= v of {
            true -> e;
            false -> exponent_of(v, e - 1)
        }
    }
}

// Peel bits `bit`..0 off an integer-valued float f < 2^(bit+1) into an int64.
fn peel(f: float64, bit: int64, acc: int64) -> int64 {
    case bit < 0 of {
        true -> acc;
        false -> case f >= pow2(bit, 0, one()) of {
            true -> peel(f - pow2(bit, 0, one()), bit - 1, acc * 2 + 1);
            false -> peel(f, bit - 1, acc * 2)
        }
    }
}

fn exp_of_abs(v: float64) -> int64 {
    case is_zero_f(v) of { true -> 0 - 1075; false -> exponent_of(abs_f(v), 1023) }
}
fn biased_exp(e: int64) -> int64 { case e < 0 - 1022 of { true -> 0; false -> e + 1023 } }
fn mantissa_float(a: float64, e: int64) -> float64 {
    case e < 0 - 1022 of {
        true -> scale2(a, 1074);
        false -> scale2(a, 52 - e) - pow2(52, 0, one())
    }
}
fn mantissa_int(v: float64) -> int64 { peel(mantissa_float(abs_f(v), exp_of_abs(v)), 51, 0) }

fn put_bytes(b: buf(L, normal, uint8, 8), n: int64, i: int64, last: int64) -> atom {
    sequence proc[mem(normal)]
        v: uint8 <- low_byte(n);
        _: atom <- write_buf(b, i, v);
        rest: atom <- case i == last of { true -> :ok; false -> put_bytes(b, n / 256, i + 1, last) }
    produces pure rest end
}

fn write_parts(b: buf(L, normal, uint8, 8), neg: boolean, biased: int64, mant: int64) -> atom {
    sequence
        _: atom <- put_bytes(b, mant, 0, 5);
        b6: int64 <- mant / 281474976710656 + (biased % 16) * 16;
        b7: int64 <- biased / 16 + (case neg of { true -> 128; false -> 0 });
        _: atom <- put_bytes(b, b6, 6, 6);
        _: atom <- put_bytes(b, b7, 7, 7)
    produces pure :ok end
}

// The value is fetched afresh for each use (SD-14: a float parameter does not survive a call).
fn encode_f64(b: buf(L, normal, uint8, 8), i: int64) -> atom {
    write_parts(b, is_neg(value(i)), biased_exp(exp_of_abs(value(i))), mantissa_int(value(i)))
}

fn show(b: buf(L, normal, uint8, 8), i: int64) -> atom {
    sequence proc[device_io]
        v: int64 <- byte_i(b, i);
        _: atom <- print_int64(v);
        print_string(" ");
        r: atom <- case i == 0 of { true -> :ok; false -> show(b, i - 1) }
    produces pure r end
}

fn same(a: float64, b: float64) -> boolean { a == b }

fn v0() -> float64 { 1.0 }
fn v1() -> float64 { 0.0 - 2.5 }
fn v2() -> float64 { 0.1 }
fn v3() -> float64 { 3.14159 }
fn v4() -> float64 { 1.0e300 }
fn v5() -> float64 { 0.0 }
fn v6() -> float64 { 4.9e-324 }
fn value(i: int64) -> float64 {
    case i of { 0 -> v0(); 1 -> v1(); 2 -> v2(); 3 -> v3(); 4 -> v4(); 5 -> v5(); _: int64 -> v6() }
}

fn round_trip(b: buf(L, normal, uint8, 8), i: int64) -> atom {
    sequence proc[device_io]
        _: atom <- encode_f64(b, i);
        _: atom <- show(b, 7);
        ok: boolean <- same(decode_f64(b), value(i));
        _: atom <- print_bool(ok);
        println("");
        rest: atom <- case i == 6 of { true -> :ok; false -> round_trip(b, i + 1) }
    produces pure rest end
}

fn main() -> int64 {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        b: buf(L, normal, uint8, 8) <- alloc_buf(r, 8);
        _: atom <- round_trip(b, 0)
    produces pure 0 end
}
