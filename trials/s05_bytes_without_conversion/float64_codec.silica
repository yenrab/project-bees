// S5: IEEE 754 float64 <-> 8 bytes (shown most significant first) with no bit-cast and no
// int/float conversion: exponent and mantissa by int64 arithmetic on the bytes, the mantissa as a
// float by per-bit powers of two, scaling by powers of two built from ten literals (all exact).
// Expected: the seven lines match Python's struct.pack('>d', v) and every decode compares equal.
// Written in the shapes the FP1 emitter compiles correctly (SD-14): float functions are single
// expressions, float literals in case arms are calls to nullary functions, a float parameter is
// never used again after a call, and ints and floats meet only through calls.
// Cost: decode ~1.4 us; encode ~180 us with this descending exponent search (a binary search
// over the ten powers would bring it near the decode cost).
fn ipow2(i: int64) -> int64 {
    case i of { 0 -> 1; 1 -> 2; 2 -> 4; 3 -> 8; 4 -> 16; 5 -> 32; 6 -> 64; _: int64 -> 128 }
}
// bits i..0 of n (0 <= n < 256) as a float, adding 2^i for each set bit (no literal float arms)
fn bits_f(n: int64, i: int64) -> float64 {
    case i < 0 of {
        true -> zero();
        false -> case (n / ipow2(i)) % 2 == 1 of {
            true -> pow2(i, 0, one()) + bits_f(n, i - 1);
            false -> bits_f(n, i - 1)
        }
    }
}
fn u8_to_f64(b: uint8) -> float64 { bits_f(u8_to_i64(b), 7) }
