// SD-7: a region moved into a message is never reclaimed after the receiving behaviour
// returns. 100,000 casts each carrying a fresh region with two cells: peak RSS 550 MB
// (~5.5 KB per message), against 17 MB for 100,000 int64 casts and 9 MB for 100,000 regions
// allocated and dropped at function scope exit (which ARE reclaimed). Measure with
// /usr/bin/time -l; the output itself only proves the messages were all delivered.
fn some_term(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> ref?(L, normal, rec) {
    c
}

fn sum_chain(root: ref?(L, normal, rec)) -> int64 {
    sequence proc[mem(normal)]
        total: int64 <- case root of {
            :none -> 0;
            c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> {
                node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: atom, v: int64, nxt: ref?(L, normal, rec)) <- node;
                v + sum_chain(nxt)
            }
        }
    produces pure total end
}

fn beh(msg: { r: region(L, normal), root: ref?(L, normal, rec) }, state: int64) -> (:reply, int64, int64) {
    sequence
        got: int64 <- sum_chain(msg.root);
        new_total: int64 <- state + got
    produces pure (:reply, new_total, new_total) end
}

fn build_message(a: int64, b: int64) -> { r: region(L, normal), root: ref?(L, normal, rec) } {
    sequence proc[mem(normal)]
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        n2: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, b, :none));
        n1: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- alloc_rec(r, (:ok, a, n2))
    produces pure { r: r, root: some_term(n1) } end
}

fn send_n(a: actor_ref, n: int64) -> int64 {
    sequence proc[concurrency]
        m: { r: region(L, normal), root: ref?(L, normal, rec) } <- build_message(1, 2);
        _: boolean <- cast(a, m impl ActorMessage {});
        rest: int64 <- case n <= 1 of {
            true -> 0;
            false -> send_n(a, n - 1)
        }
    produces pure rest end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io]
        a: actor_ref <- spawn(0, beh);
        _: int64 <- send_n(a, 100000);
        last: { r: region(L, normal), root: ref?(L, normal, rec) } <- build_message(0, 0);
        v: int64 <- call(a, last impl ActorMessage {});
        _: atom <- print_int64(v);
        println("")
    produces pure 0 end
}
