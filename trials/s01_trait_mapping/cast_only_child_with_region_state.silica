// S1: a Supervisor whose child is a cast-only actor with a region-holding state, the shape of a
// BEAM process (D1, D18). The child appends a term per message and reports its chain length by
// casting to a call-only collector. A message of 0 divides by zero to kill the child; the
// supervisor restarts it from the STORED initial state, which holds the SAME region handle the
// dead child was using (regions are move-only and never freed while the actor lives). The chain
// length after the restart shows whether the restarted child sees a fresh region (1) or the dead
// child's cells (SD-10 if so).
use Supervisor;

impl S1Sup for Supervisor;

fn some_term(c: ref(L, normal, (atom, int64, ref?(L, normal, rec)))) -> ref?(L, normal, rec) { c }

fn chain_len(root: ref?(L, normal, rec)) -> int64 {
    sequence proc[mem(normal)]
        n: int64 <- case root of {
            :none -> 0;
            c: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> {
                node: (atom, int64, ref?(L, normal, rec)) <- read_ref(c);
                (_: atom, _: int64, nxt: ref?(L, normal, rec)) <- node;
                1 + chain_len(nxt)
            }
        }
    produces pure n end
}

fn process(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }) -> (:no_reply, { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }) {
    sequence proc[mem(normal), concurrency]
        cell: ref(L, normal, (atom, int64, ref?(L, normal, rec))) <- case state.root of {
            :none -> alloc_rec(state.r, (:int, 100 / msg, :none));
            prev: ref(L, normal, (atom, int64, ref?(L, normal, rec))) -> alloc_rec(state.r, (:int, 100 / msg, prev))
        };
        n: int64 <- chain_len(some_term(cell));
        _: boolean <- cast(state.collector, n impl ActorMessage {})
    produces pure (:no_reply, { r: state.r, root: some_term(cell), collector: state.collector }) end
}

fn collector(msg: int64, state: int64) -> (:reply, int64, int64) {
    (:reply, state, state * 10 + msg)
}

fn init(initial_state: { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }) -> (
    { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 },
    List[{ id: atom, agent_type: :worker | :supervisor, initial_state: { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }, behavior: fn(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }) -> (:no_reply, { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)]
) {
    sequence proc[mem(normal)]
        flags: { strategy: :one_for_one | :one_for_all | :rest_for_one, allowed_restart_count: int64, restarts_time_frame: int64 } <- { strategy: :one_for_one, allowed_restart_count: 5, restarts_time_frame: 10 };
        children: List[{ id: atom, agent_type: :worker | :supervisor, initial_state: { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }, behavior: fn(msg: int64, state: { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }) -> (:no_reply, { r: region(L, normal), root: ref?(L, normal, rec), collector: actor_ref }), restart: :permanent | :temporary | :transient, shutdown: int64, flavor: :plain | :dangerous }, mem(normal)] <- [
            { id: :s1_process, agent_type: :worker, initial_state: initial_state, behavior: process, restart: :permanent, shutdown: 0, flavor: :plain }
        ]
    produces pure (flags, children) end
}

fn child_of(sup: supervisor_ref) -> actor_ref {
    sequence
        got: { tag: :child_started | :ok | :children | :count | :child_info | :error, child: actor_ref, status: atom, children: List[{ id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, mem(normal)], count: int64, child_info: { id: atom, agent_type: :worker | :supervisor, child: actor_ref, restart: :permanent | :temporary | :transient }, error: atom } <- call_supervisor(sup, { op: :get_child, id: :s1_process } impl SupervisorMessage {})
    produces pure got.child end
}

fn main() -> int64 {
    sequence proc[concurrency, device_io, mem(normal)]
        col: actor_ref <- spawn(0, collector);
        L: lifetime <- fresh_lifetime();
        r: region(L, normal) <- alloc_region(normal);
        sup: supervisor_ref <- spawn_registered_supervisor(S1Sup, { r: r, root: :none, collector: col }, :s1_sup);
        c1: actor_ref <- child_of(sup);
        _: boolean <- cast(c1, 1 impl ActorMessage {});
        _: boolean <- cast(c1, 2 impl ActorMessage {});
        _: boolean <- cast(c1, 0 impl ActorMessage {});
        // Synchronise on the collector: wait until it has seen the two lengths (1, then 2).
        // A call to the collector also orders after the casts the child made before dying.
        seen: int64 <- call(col, 0 impl ActorMessage {});
        _: atom <- print_int64(seen);
        println("");
        c2: actor_ref <- child_of(sup);
        _: boolean <- cast(c2, 4 impl ActorMessage {});
        seen2: int64 <- call(col, 0 impl ActorMessage {});
        _: atom <- print_int64(seen2);
        println("")
    produces pure 0 end
}
