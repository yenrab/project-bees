module bees_spike_atom_a;
// Spike S2: unit A mints atoms. Under D30 it writes no atom literal of its own: every BEAM
// atom comes from the generated bees_atoms unit, so the number A hands out is the one every
// other unit compares against.
use bees_atoms;

export mint_zebra/0;
export mint_apple/0;
export mint_mango/0;
export mint_pair/0;

fn mint_zebra() -> atom { bees_atoms@a_zebra() }
fn mint_apple() -> atom { bees_atoms@a_apple() }
fn mint_mango() -> atom { bees_atoms@a_mango() }
fn mint_pair() -> (atom, int64) { (bees_atoms@a_mango(), 7) }
