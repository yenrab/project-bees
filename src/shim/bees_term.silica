module bees_term;
// GENERATED by tools/gen_bees_term.py; edit the template there.
//
// bees_term v0 (spike S9; contract item 1 draft). A term is a cell in a region:
//   (tag, n, f, a, p, h, t)
//   tag  0 nil  1 int(n)  2 float(f)  3 mk_atom(a)  4 pid(p)  5 mk_cons(h=head, t=tail)
//        6 tuple(n=arity, h=element list)  7 binary(n=byte count, h=list of int cells 0..255)
//        8 fun(n=module index, h=(fn index, env list) as a cons)
// Every atom in a term comes from bees_atoms (D30); this unit writes none.
// Constructors take and return the heap record { r, c } (SD-20: a (region, ref) tuple return
// crashes on actor threads) and put the new cell in c. Every region that holds terms is
// region(L, normal) (SD-6). Optional references are written ref?(L, normal, rec) (SD-4) and are
// bound only through records (SD-5).

export mk_nil/1;
export mk_int/2;
export mk_float/2;
export mk_atom/2;
export mk_pid/2;
export mk_cons/3;
export mk_tuple/3;
export tag/1;
export int_of/1;
export float_of/1;
export atom_of/1;
export pid_of/1;
export hd_of/1;
export tl_of/1;
export arity/1;
export list_len/1;
export nth/2;
export copy/2;
export eq/2;
export is_none/1;
export wrap/1;
export heap_of/1;
export wrap_ref/1;

fn some(c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> ref?(L, normal, rec) { c }
// The public widening of a cell reference to an optional one (SD-5).
fn wrap_ref(c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> ref?(L, normal, rec) { c }
fn wrap(c: ref?(L, normal, rec)) -> { c: ref?(L, normal, rec) } { { c: c } }
// The heap record for a region with no cell yet (a record literal with :none needs this return type).
fn heap_of(r: region(L, normal)) -> { r: region(L, normal), c: ref?(L, normal, rec) } { { r: r, c: :none } }
fn is_none(c: ref?(L, normal, rec)) -> boolean { case c of { :none -> true; _: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> false } }

fn mk_nil(h: { r: region(L, normal), c: ref?(L, normal, rec) }) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    sequence proc[mem(normal), concurrency]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (0, 0, 0.0, :ok, self(), :none, :none))
    produces pure { r: h.r, c: some(c) } end
}
fn mk_int(h: { r: region(L, normal), c: ref?(L, normal, rec) }, n: int64) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    sequence proc[mem(normal), concurrency]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (1, n, 0.0, :ok, self(), :none, :none))
    produces pure { r: h.r, c: some(c) } end
}
fn mk_float(h: { r: region(L, normal), c: ref?(L, normal, rec) }, f: float64) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    sequence proc[mem(normal), concurrency]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (2, 0, f, :ok, self(), :none, :none))
    produces pure { r: h.r, c: some(c) } end
}
fn mk_atom(h: { r: region(L, normal), c: ref?(L, normal, rec) }, a: atom) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    sequence proc[mem(normal), concurrency]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (3, 0, 0.0, a, self(), :none, :none))
    produces pure { r: h.r, c: some(c) } end
}
fn mk_pid(h: { r: region(L, normal), c: ref?(L, normal, rec) }, p: actor_ref) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    sequence proc[mem(normal)]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (4, 0, 0.0, :ok, p, :none, :none))
    produces pure { r: h.r, c: some(c) } end
}
fn mk_cons(h: { r: region(L, normal), c: ref?(L, normal, rec) }, hd: ref?(L, normal, rec), tl: ref?(L, normal, rec)) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    sequence proc[mem(normal), concurrency]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (5, 0, 0.0, :ok, self(), hd, tl))
    produces pure { r: h.r, c: some(c) } end
}
// A tuple of arity n over a list of its elements (built with cons, nil-terminated).
fn mk_tuple(h: { r: region(L, normal), c: ref?(L, normal, rec) }, n: int64, elements: ref?(L, normal, rec)) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    sequence proc[mem(normal), concurrency]
        c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) <- alloc_rec(h.r, (6, n, 0.0, :ok, self(), elements, :none))
    produces pure { r: h.r, c: some(c) } end
}

fn read(c: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)) {
    sequence proc[mem(normal)]
        node: (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(c)
    produces pure node end
}

fn tag(c: ref?(L, normal, rec)) -> int64 {
    case c of {
        :none -> 0 - 1;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (tg: int64, _: int64, _: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            tg
        }
    }
}
fn int_of(c: ref?(L, normal, rec)) -> int64 {
    case c of {
        :none -> 0;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, n: int64, _: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            n
        }
    }
}
// A float64-returning function must not destructure the cell (SD-14 class: the emitter uses D0
// as the base register), so the slot is fetched through a record.
fn float_slot(x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)))) -> { f: float64 } {
    sequence proc[mem(normal)]
        node: (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec)) <- read_ref(x);
        (_: int64, _: int64, f: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- node
    produces pure { f: f } end
}
fn fzero() -> float64 { 0.0 }
fn float_of(c: ref?(L, normal, rec)) -> float64 {
    case c of {
        :none -> fzero();
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> fget(float_slot(x))
    }
}
fn fget(s: { f: float64 }) -> float64 { s.f }
fn atom_of(c: ref?(L, normal, rec)) -> atom {
    case c of {
        :none -> :unknown;
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, _: int64, _: float64, a: atom, _: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            a
        }
    }
}
fn pid_of(c: ref?(L, normal, rec)) -> actor_ref {
    sequence proc[concurrency]
        me: actor_ref <- self();
        p: actor_ref <- case c of {
            :none -> me;
            x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
                (_: int64, _: int64, _: float64, _: atom, q: actor_ref, _: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
                q
            }
        }
    produces pure p end
}
fn hd_of(c: ref?(L, normal, rec)) -> { c: ref?(L, normal, rec) } {
    case c of {
        :none -> { c: :none };
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, _: int64, _: float64, _: atom, _: actor_ref, hd: ref?(L, normal, rec), _: ref?(L, normal, rec)) <- read(x);
            { c: hd }
        }
    }
}
fn tl_of(c: ref?(L, normal, rec)) -> { c: ref?(L, normal, rec) } {
    case c of {
        :none -> { c: :none };
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (_: int64, _: int64, _: float64, _: atom, _: actor_ref, _: ref?(L, normal, rec), tl: ref?(L, normal, rec)) <- read(x);
            { c: tl }
        }
    }
}
fn arity(c: ref?(L, normal, rec)) -> int64 { int_of(c) }

// Length of a cons list (nil-terminated); a non-list ends the count.
fn list_len(c: ref?(L, normal, rec)) -> int64 {
    case tag(c) == 5 of {
        true -> {
            t: { c: ref?(L, normal, rec) } <- tl_of(c);
            1 + list_len(t.c)
        };
        false -> 0
    }
}
// The i-th element (0-based) of a cons list, or none.
fn nth(c: ref?(L, normal, rec), i: int64) -> { c: ref?(L, normal, rec) } {
    case tag(c) == 5 of {
        true -> case i == 0 of {
            true -> hd_of(c);
            false -> {
                t: { c: ref?(L, normal, rec) } <- tl_of(c);
                nth(t.c, i - 1)
            }
        };
        false -> { c: :none }
    }
}

// Deep copy of a term from any region into the heap h (evacuation, roadmap §4.2).
fn copy(h: { r: region(L, normal), c: ref?(L, normal, rec) }, c: ref?(L, normal, rec)) -> { r: region(L, normal), c: ref?(L, normal, rec) } {
    case c of {
        :none -> { r: h.r, c: :none };
        x: ref(L, normal, (int64, int64, float64, atom, actor_ref, ref?(L, normal, rec), ref?(L, normal, rec))) -> {
            (tg: int64, n: int64, f: float64, a: atom, p: actor_ref, hd: ref?(L, normal, rec), tl: ref?(L, normal, rec)) <- read(x);
            case tg of {
                5 -> {
                    h1: { r: region(L, normal), c: ref?(L, normal, rec) } <- copy(h, hd);
                    h2: { r: region(L, normal), c: ref?(L, normal, rec) } <- copy(h1, tl);
                    mk_cons(h2, h1.c, h2.c)
                };
                6 -> {
                    h1: { r: region(L, normal), c: ref?(L, normal, rec) } <- copy(h, hd);
                    mk_tuple(h1, n, h1.c)
                };
                2 -> mk_float(h, f);
                3 -> mk_atom(h, a);
                4 -> mk_pid(h, p);
                1 -> mk_int(h, n);
                _: int64 -> mk_nil(h)
            }
        }
    }
}

// Structural equality (=:= for the v0 types; floats compare exactly).
fn eq(a: ref?(L, normal, rec), b: ref?(L, normal, rec)) -> boolean {
    case tag(a) == tag(b) of {
        false -> false;
        true -> case tag(a) of {
            0 -> true;
            1 -> int_of(a) == int_of(b);
            2 -> feq(float_of(a), float_of(b));
            3 -> atom_of(a) == atom_of(b);
            4 -> same_pid(pid_of(a), pid_of(b));
            5 -> {
                ha: { c: ref?(L, normal, rec) } <- hd_of(a);
                hb: { c: ref?(L, normal, rec) } <- hd_of(b);
                ta: { c: ref?(L, normal, rec) } <- tl_of(a);
                tb: { c: ref?(L, normal, rec) } <- tl_of(b);
                eq(ha.c, hb.c) and eq(ta.c, tb.c)
            };
            6 -> {
                ha: { c: ref?(L, normal, rec) } <- hd_of(a);
                hb: { c: ref?(L, normal, rec) } <- hd_of(b);
                arity(a) == arity(b) and eq(ha.c, hb.c)
            };
            _: int64 -> false
        }
    }
}
fn feq(x: float64, y: float64) -> boolean { x == y }
// Pid equality waits on S-26: actor_ref_equal is specified (2026-09-15) but not in the fixed
// point (it links as an undefined symbol), and the comparison operators do not apply to
// references. Until then two pids are never equal (recorded in the S9 note).
fn same_pid(x: actor_ref, y: actor_ref) -> boolean { false }
